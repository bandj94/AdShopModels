# ---- Secrets & local config ----
.env
.env.*
!.env.example
# The ACTIVE profile is machine-local; config/profiles/ is tracked.
/config/config.yaml
# Lab-only SSH keypairs, never commit.
keys/
*.pem
*.key

# ---- Run artifacts ----
# Ignore everything in runs/ ...
/runs/*
# ... except the committed example and the dir placeholder.
!/runs/sample-run/
!/runs/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# ---- Node ----
node_modules/
npm-debug.log*

# ---- Docker / infra local state ----
*.local.yml
.docker/
infra/**/.env

# ---- VM artifacts (future vm-mode) ----
.vagrant/
*.box
*.qcow2
*.vdi
*.vmdk

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# ---- Claude Code (machine-local settings) ----
.claude/settings.local.json
