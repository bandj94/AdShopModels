<!--
  Custom Wazuh rules for the LLM Adversary Lab.
  Mounted read-only into the manager (see infra/docker/overrides/siem.wazuh.yml) and ingested
  alongside Suricata's eve.json. Rule ids in the local 100000+ range.
-->
<group name="llm_adversary_lab,">

  <!-- Base: any Suricata alert that reaches the manager via the shared eve.json. -->
  <rule id="100100" level="6">
    <decoded_as>json</decoded_as>
    <field name="event_type">alert</field>
    <description>Lab IDS alert: $(alert.signature)</description>
    <group>ids,suricata,mitre,</group>
  </rule>

  <!-- Escalate SQLi tooling. -->
  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="alert.signature">sqlmap</field>
    <description>SQLi tool (sqlmap) against lab target [T1190]</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web_attack,</group>
  </rule>

  <!-- Escalate scan bursts. -->
  <rule id="100102" level="8">
    <if_sid>100100</if_sid>
    <field name="alert.signature">SYN scan</field>
    <description>Network service discovery / port scan against lab target [T1046]</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,</group>
  </rule>

</group>
