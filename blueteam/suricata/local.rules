# Custom Suricata signatures for the LLM Adversary Lab. ATT&CK-annotated.
# $HOME_NET is the lab target. sids in the local 9000000+ range.

# T1046 — Network Service Discovery (nmap-style SYN scan).
alert tcp any any -> $HOME_NET any ( \
    msg:"LAB T1046 nmap-style SYN scan"; flags:S; \
    threshold:type both, track by_src, count 20, seconds 5; \
    classtype:attempted-recon; sid:9000001; rev:1; \
    metadata:mitre_technique_id T1046; )

# T1190 — Exploit Public-Facing Application (sqlmap signature in HTTP).
alert http any any -> $HOME_NET any ( \
    msg:"LAB T1190 sqlmap user-agent"; http.user_agent; content:"sqlmap"; nocase; \
    classtype:web-application-attack; sid:9000002; rev:1; \
    metadata:mitre_technique_id T1190; )

# T1595.003 — Wordlist Scanning (content-discovery tools).
alert http any any -> $HOME_NET any ( \
    msg:"LAB T1595.003 content discovery tool"; http.user_agent; \
    pcre:"/gobuster|ffuf|feroxbuster|dirb/i"; \
    classtype:web-application-activity; sid:9000003; rev:1; \
    metadata:mitre_technique_id T1595.003; )

# T1190 — classic SQLi tautology in a URI.
alert http any any -> $HOME_NET any ( \
    msg:"LAB T1190 SQLi tautology in URI"; http.uri; content:"' OR '1'='1"; nocase; \
    classtype:web-application-attack; sid:9000004; rev:1; \
    metadata:mitre_technique_id T1190; )
