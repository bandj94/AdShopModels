# Normalize line endings. Shell scripts MUST stay LF so they run inside Linux containers.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Makefile text eol=lf

# Binary-ish assets
*.png   binary
*.jpg   binary
*.box   binary
