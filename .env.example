# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------
# Model server (Ollama on the HOST, OpenAI-compatible API)
# The orchestrator runs on the host, so it reaches Ollama at localhost.
OLLAMA_HOST=http://localhost:11434
LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# Lab network (isolated, no egress). Docker-internal by default.
LAB_CIDR=10.13.37.0/24
ATTACKER_IP=10.13.37.10
TARGET_IP=10.13.37.20
SIEM_IP=10.13.37.30

# ---------------------------------------------------------------------------
# Active profile selection (see config/profiles/). Used by lab.py.
LAB_PROFILE=docker-web

# ---------------------------------------------------------------------------
# Blue-team dashboard (bound to HOST localhost only, never to the lab net)
WAZUH_DASHBOARD_PORT=5601
WAZUH_INDEXER_PASSWORD=change-me-local-only

# ---------------------------------------------------------------------------
# Run bounds (safety). Overridable per profile.
RUN_MAX_STEPS=40
RUN_STEP_TIMEOUT_S=120

# ---------------------------------------------------------------------------
# Container image tags (pin to versions you've pulled for reproducibility).
JUICE_SHOP_TAG=v16.0.0
DVWA_TAG=latest
SURICATA_TAG=latest
WAZUH_TAG=4.9.2
